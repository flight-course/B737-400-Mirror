	EVENT_NAME /b738/equipment/doors/cockpit_open
	VEH_XYZ -0.056 1.035 -14.496
	PARAM_DREF_IDX 20
	EVENT_START_COND DELTA=sim/flightmodel2/misc/custom_slider_ratio[20] > 0
