	EVENT_NAME /b738/equipment/air/packs_fan
	VEH_XYZ 3.696 -0.069 -0.726
	PARAM_DREF_IDX 1
	EVENT_START_COND laminar/B738/sound/packs_flow[1] > 0.1
	EVENT_END_COND laminar/B738/sound/packs_flow[1] < 0.1
END_SOUND_ATTACHMENT

# -------------------- Hydraulic ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/pumps/hydraulic
	VEH_XYZ 0.000 -0.260 1.701
	EVENT_ALLOWED_FOR_AI
	EVENT_START_COND sim/cockpit2/switches/electric_hydraulic_pump_on != 0
	EVENT_END_COND sim/cockpit2/switches/electric_hydraulic_pump_on == 0
END_SOUND_ATTACHMENT

# -------------------- Fuel pumps ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/pumps/fuel
	VEH_XYZ -3.696 -0.069 -0.726
	EVENT_ALLOWED_FOR_AI
	EVENT_START_COND sim/cockpit2/fuel/fuel_tank_pump_on[0] == 1
	EVENT_END_COND sim/cockpit2/fuel/fuel_tank_pump_on[0] == 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/pumps/fuel
	VEH_XYZ 0.894 -1.232 -3.310
	EVENT_START_COND sim/cockpit2/fuel/fuel_tank_pump_on[1] == 1
	EVENT_END_COND sim/cockpit2/fuel/fuel_tank_pump_on[1] == 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/pumps/fuel
	VEH_XYZ 3.696 -0.069 -0.726
	EVENT_START_COND sim/cockpit2/fuel/fuel_tank_pump_on[2] == 1
	EVENT_END_COND sim/cockpit2/fuel/fuel_tank_pump_on[2] == 0
END_SOUND_ATTACHMENT

# -------------------- Flaps motor ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/flaps/flaps
	VEH_XYZ 0.000 -0.260 1.701
	PARAM_DREF_IDX 0
	EVENT_START_COND ABS_DELTA=sim/flightmodel2/wing/flap1_deg[0] > 0
	EVENT_END_COND ABS_DELTA=sim/flightmodel2/wing/flap1_deg[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Wipers ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/wipers/wipers
	VEH_XYZ 0.000 1.101 -16.667
	EVENT_START_COND sim/cockpit2/switches/wiper_speed > 0
	EVENT_END_COND sim/cockpit2/switches/wiper_speed == 0
END_SOUND_ATTACHMENT

