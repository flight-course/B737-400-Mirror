# Switches: Fire 
#############################################################################################

# -------------------- Fire test ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/switches/switch_white_small
	VEH_XYZ -0.116 0.619 -15.811
	EVENT_START_COND ABS_DELTA=laminar/B738/toggle_switch/fire_test > 0
	EVENT_END_COND ABS_DELTA=laminar/B738/toggle_switch/fire_test == 0
END_SOUND_ATTACHMENT

# -------------------- Extinguisher test ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/switches/switch_metal
	VEH_XYZ 0.106 0.576 -15.835
	EVENT_START_COND ABS_DELTA=laminar/B738/toggle_switch/extinguisher_circuit_test > 0
	EVENT_END_COND ABS_DELTA=laminar/B738/toggle_switch/extinguisher_circuit_test == 0
END_SOUND_ATTACHMENT

# -------------------- Fire handle 1 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/switches/fire_handle_pull_push
	VEH_XYZ -0.081 0.625 -15.822
	EVENT_START_COND DELTA=laminar/B738/fire/engine01/ext_switch/pos_arm > 0
	CUE_TRIGGER_COND DELTA=laminar/B738/fire/engine01/ext_switch/pos_arm < 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/switches/fire_handle_rotate
	VEH_XYZ -0.081 0.625 -15.822
	EVENT_START_COND ABS_DELTA=sim/cockpit2/engine/actuators/fire_extinguisher_on[0] > 0
	EVENT_END_COND ABS_DELTA=sim/cockpit2/engine/actuators/fire_extinguisher_on[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Fire handle APU ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/switches/fire_handle_pull_push
	VEH_XYZ 0.000 0.625 -15.822
	EVENT_START_COND DELTA=laminar/B738/fire/apu/ext_switch/pos_arm > 0
	CUE_TRIGGER_COND DELTA=laminar/B738/fire/apu/ext_switch/pos_arm < 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/switches/fire_handle_rotate
	VEH_XYZ 0.000 0.625 -15.822
	EVENT_START_COND ABS_DELTA=laminar/B738/fire/apu/ext_on > 0
	EVENT_END_COND ABS_DELTA=laminar/B738/fire/apu/ext_on == 0
END_SOUND_ATTACHMENT

# -------------------- Fire handle 2 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/switches/fire_handle_pull_push
	VEH_XYZ 0.081 0.625 -15.822
	EVENT_START_COND DELTA=laminar/B738/fire/engine02/ext_switch/pos_arm > 0
	CUE_TRIGGER_COND DELTA=laminar/B738/fire/engine02/ext_switch/pos_arm < 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/switches/fire_handle_rotate
	VEH_XYZ -0.081 0.625 -15.822
	EVENT_START_COND ABS_DELTA=sim/cockpit2/engine/actuators/fire_extinguisher_on[1] > 0
	EVENT_END_COND ABS_DELTA=sim/cockpit2/engine/actuators/fire_extinguisher_on[1] == 0
END_SOUND_ATTACHMENT

