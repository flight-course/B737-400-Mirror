A
1000
ACF_SOUNDS

###############################################
# Boeing 737-800 sound bank                   #
# 1.0.1                                       #
# Daniela Rodriguez <dcareri@gmail.com>       #
# Laminar Research                            #
###############################################

DISABLE_LEGACY_ALERT_SOUNDS

# Spaces 
#############################################################################################

# -------------------- Cockpit ---------------------
BEGIN_SOUND_SPACE
	SOUND_INDEX 0
	BLEND_DEPTH 0.1
	AABB -1.310 0.000 -17.150 1.310 2.100 -14.100
END_SOUND_SPACE

# -------------------- Passenger cabin ---------------------
BEGIN_SOUND_SPACE
	SOUND_INDEX 1
	BLEND_DEPTH 0.1
	AABB -1.800 0.000 -14.300 1.800 2.300 15.000
END_SOUND_SPACE

# Snapshots 
#############################################################################################

# -------------------- Mute sounds during initialization ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /ducker
	EVENT_START_COND sim/time/total_flight_time_sec > 0
	EVENT_END_COND sim/time/total_flight_time_sec > 5
END_SOUND_ATTACHMENT

# -------------------- Cockpit ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /in_cockpit
	VEH_XYZ 0.000 1.313 -15.883
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/operation/sound/inside_ratio[0] != 0
	EVENT_END_COND sim/operation/sound/inside_ratio[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Fwd port door (from cockpit) ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /door_fwd_cockpit
	VEH_XYZ -1.235 1.570 -13.172
	PARAM_DREF_IDX 14
	EVENT_START_COND sim/flightmodel2/misc/custom_slider_ratio[14] > 0
	EVENT_END_COND sim/flightmodel2/misc/custom_slider_ratio[14] == 0
END_SOUND_ATTACHMENT

# -------------------- Fwd starboard door (from cockpit) ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /door_fwd_cockpit
	VEH_XYZ 1.235 1.570 -13.172
	PARAM_DREF_IDX 16
	EVENT_START_COND sim/flightmodel2/misc/custom_slider_ratio[16] > 0
	EVENT_END_COND sim/flightmodel2/misc/custom_slider_ratio[16] == 0
END_SOUND_ATTACHMENT

# -------------------- Cabin ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /in_cabin
	VEH_XYZ 0.000 1.364 -14.334
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/operation/sound/inside_ratio[1] != 0
	EVENT_END_COND sim/operation/sound/inside_ratio[1] == 0
END_SOUND_ATTACHMENT

# -------------------- Aft port door ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /door_aft
	VEH_XYZ -1.267 1.325 13.630
	PARAM_DREF_IDX 15
	EVENT_START_COND sim/flightmodel2/misc/custom_slider_ratio[15] > 0
	EVENT_END_COND sim/flightmodel2/misc/custom_slider_ratio[14] == 0
END_SOUND_ATTACHMENT

# -------------------- Aft starboard door ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /door_aft
	VEH_XYZ 1.267 1.325 13.630
	PARAM_DREF_IDX 17
	EVENT_START_COND sim/flightmodel2/misc/custom_slider_ratio[17] > 0
	EVENT_END_COND sim/flightmodel2/misc/custom_slider_ratio[17] == 0
END_SOUND_ATTACHMENT

# -------------------- Fwd port door ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /door_fwd
	VEH_XYZ -1.235 1.570 -13.172
	PARAM_DREF_IDX 14
	EVENT_START_COND sim/flightmodel2/misc/custom_slider_ratio[14] > 0
	EVENT_END_COND sim/flightmodel2/misc/custom_slider_ratio[14] == 0
END_SOUND_ATTACHMENT

# -------------------- Fwd starboard door ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /door_fwd
	VEH_XYZ 1.235 1.570 -13.172
	PARAM_DREF_IDX 16
	EVENT_START_COND sim/flightmodel2/misc/custom_slider_ratio[16] > 0
	EVENT_END_COND sim/flightmodel2/misc/custom_slider_ratio[16] == 0
END_SOUND_ATTACHMENT

# -------------------- Port emergency door 1 ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /door_emer
	VEH_XYZ -1.569 1.284 -1.535
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/misc/door_open_ratio[1] > 0
	EVENT_END_COND sim/flightmodel2/misc/door_open_ratio[1] == 0
END_SOUND_ATTACHMENT

# -------------------- Port emergency door 2 ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /door_emer
	VEH_XYZ -1.602 1.284 -0.553
	PARAM_DREF_IDX 2
	EVENT_START_COND sim/flightmodel2/misc/door_open_ratio[2] > 0
	EVENT_END_COND sim/flightmodel2/misc/door_open_ratio[2] == 0
END_SOUND_ATTACHMENT

# -------------------- Starboard emergency door 1 ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /door_emer
	VEH_XYZ 1.569 1.284 -1.535
	PARAM_DREF_IDX 5
	EVENT_START_COND sim/flightmodel2/misc/door_open_ratio[5] > 0
	EVENT_END_COND sim/flightmodel2/misc/door_open_ratio[5] == 0
END_SOUND_ATTACHMENT

# -------------------- Starboard emergency door 2 ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /door_emer
	VEH_XYZ 1.602 1.284 -0.553
	PARAM_DREF_IDX 6
	EVENT_START_COND sim/flightmodel2/misc/door_open_ratio[6] > 0
	EVENT_END_COND sim/flightmodel2/misc/door_open_ratio[6] == 0
END_SOUND_ATTACHMENT

# Engines 
#############################################################################################

# -------------------- Engine 1 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/engine_1
	VEH_PART engine 0
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/engines/N2_percent[0] != 0
	EVENT_END_COND sim/flightmodel2/engines/N2_percent[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Reverser ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/reverser
	VEH_PART engine 0
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/engines/thrust_reverser_deploy_ratio[0] > 0
	EVENT_END_COND sim/flightmodel2/engines/thrust_reverser_deploy_ratio[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Starter ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/starter
	VEH_PART engine 0
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/engines/starter_is_running[0] != 0
	EVENT_END_COND sim/flightmodel2/engines/starter_is_running[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Start valve ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/start_valve
	VEH_PART engine 0
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/engines/starter_is_running[0] != 0
	EVENT_END_COND sim/flightmodel2/engines/starter_is_running[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Ignition ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/ignition
	VEH_PART engine 0
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/engines/engine_is_burning_fuel[0] == 1
	EVENT_END_COND sim/flightmodel2/engines/engine_is_burning_fuel[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Engine fire ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/engine_fire
	VEH_PART engine 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/operation/failures/rel_engfir0 == 6
	EVENT_END_COND sim/operation/failures/rel_engfir0 != 6
END_SOUND_ATTACHMENT

# -------------------- Engine 2 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/engine_2
	VEH_PART engine 1
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/engines/N2_percent[1] != 0
	EVENT_END_COND sim/flightmodel2/engines/N2_percent[1] == 0
END_SOUND_ATTACHMENT

# -------------------- Reverser ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/reverser
	VEH_PART engine 1
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/engines/thrust_reverser_deploy_ratio[1] > 0
	EVENT_END_COND sim/flightmodel2/engines/thrust_reverser_deploy_ratio[1] == 0
END_SOUND_ATTACHMENT

# -------------------- Starter ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/starter
	VEH_PART engine 1
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/engines/starter_is_running[1] != 0
	EVENT_END_COND sim/flightmodel2/engines/starter_is_running[1] == 0
END_SOUND_ATTACHMENT

# -------------------- Start valve ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/start_valve
	VEH_PART engine 1
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/engines/starter_is_running[1] != 0
	EVENT_END_COND sim/flightmodel2/engines/starter_is_running[1] == 0
END_SOUND_ATTACHMENT

# -------------------- Ignition ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/ignition
	VEH_PART engine 1
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/engines/engine_is_burning_fuel[1] == 1
	EVENT_END_COND sim/flightmodel2/engines/engine_is_burning_fuel[1] == 0
END_SOUND_ATTACHMENT

# -------------------- Engine fire ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/engines/engine_fire
	VEH_PART engine 1
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/operation/failures/rel_engfir1 == 6
	EVENT_END_COND sim/operation/failures/rel_engfir1 != 6
END_SOUND_ATTACHMENT

# Environment 
#############################################################################################

# -------------------- Wind (cockpit) ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/air/airflow
	VEH_XYZ 0.000 1.188 -16.677
	EVENT_START_COND sim/flightmodel/position/indicated_airspeed2 > 0
	EVENT_START_COND sim/flightmodel/position/true_airspeed > 2
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Wind (cabin) ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/air/airflow_cabin
	VEH_XYZ 0.000 0.000 0.000
	EVENT_START_COND sim/flightmodel/position/indicated_airspeed2 > 0
	EVENT_START_COND sim/flightmodel/position/true_airspeed > 2
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Gear airflow ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/air/gear_airflow
	VEH_XYZ 0.000 -0.442 -16.623
	EVENT_START_COND sim/flightmodel2/gear/deploy_ratio[0] > 0
	EVENT_START_COND sim/flightmodel/position/true_airspeed > 2
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Spoiler drag ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/air/spoiler_drag
	VEH_XYZ 0.000 0.000 0.000
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/wing/spoiler1_deg[0] != 0
	EVENT_END_COND sim/flightmodel2/wing/spoiler1_deg[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Flaps drag ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/air/flaps_drag
	VEH_XYZ 0.000 0.000 0.000
	EVENT_START_COND sim/cockpit2/controls/flap_ratio != 0
	EVENT_END_COND sim/cockpit2/controls/flap_ratio == 0
END_SOUND_ATTACHMENT

# -------------------- Front gear stowed ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/ground/front_gear_stowed
	VEH_XYZ 0.000 -0.442 -16.623
	EVENT_START_COND DELTA=sim/flightmodel2/gear/deploy_ratio[0] < 0
	EVENT_START_COND sim/flightmodel2/gear/deploy_ratio[0] < 0.6
	EVENT_END_COND DELTA=sim/flightmodel2/gear/deploy_ratio[0] >= 0
END_SOUND_ATTACHMENT

# -------------------- Front gear up ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/ground/front_gear_up
	VEH_XYZ 0.000 -0.442 -16.623
	EVENT_START_COND sim/flightmodel2/gear/tire_vertical_deflection_mtr[0] == 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/ground/crash
	VEH_XYZ 0.000 0.000 0.000
	EVENT_START_COND sim/operation/failures/rel_wing1L == 6
	EVENT_START_COND sim/flightmodel/position/y_agl < 1
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/ground/crash
	VEH_XYZ 0.000 0.000 0.000
	EVENT_START_COND sim/operation/failures/rel_wing1R == 6
	EVENT_START_COND sim/flightmodel/position/y_agl < 1
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/ground/belly_land
	VEH_XYZ 0.000 0.000 0.000
	EVENT_START_COND sim/aircraft/parts/acf_gear_deploy[0] < 0.2
	EVENT_START_COND sim/aircraft/parts/acf_gear_deploy[1] < 0.2
	EVENT_START_COND sim/flightmodel/failures/onground_any == 1
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Tire roll 1 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/ground/tire_roll
	VEH_PART tire 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/gear/tire_rotation_speed_rad_sec[0] > 0.2
	EVENT_END_COND sim/flightmodel2/gear/tire_rotation_speed_rad_sec[0] < 0.2
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/ground/touch_down_1
	VEH_PART tire 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/gear/total_deflection_rate[0] > 1
	EVENT_START_COND sim/flightmodel2/gear/tire_vertical_deflection_mtr[0] > 0
END_SOUND_ATTACHMENT

# -------------------- Tire roll 2 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/ground/tire_roll
	VEH_PART tire 1
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/gear/tire_rotation_speed_rad_sec[1] > 0.2
	EVENT_END_COND sim/flightmodel2/gear/tire_rotation_speed_rad_sec[1] < 0.2
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/ground/touch_down_2
	VEH_PART tire 1
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/gear/total_deflection_rate[1] > 1
	EVENT_START_COND sim/flightmodel2/gear/tire_vertical_deflection_mtr[1] > 0
END_SOUND_ATTACHMENT

# -------------------- Tire roll 3 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/ground/tire_roll
	VEH_PART tire 2
	PARAM_DREF_IDX 2
	EVENT_START_COND sim/flightmodel2/gear/tire_rotation_speed_rad_sec[2] > 0.2
	EVENT_END_COND sim/flightmodel2/gear/tire_rotation_speed_rad_sec[2] < 0.2
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/environment/ground/touch_down_3
	VEH_PART tire 2
	PARAM_DREF_IDX 2
	EVENT_START_COND sim/flightmodel2/gear/total_deflection_rate[2] > 1
	EVENT_START_COND sim/flightmodel2/gear/tire_vertical_deflection_mtr[2] > 0
END_SOUND_ATTACHMENT

# Equipment 
#############################################################################################

# -------------------- APU ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/apu/apu
	VEH_XYZ 0.000 1.436 19.177
	EVENT_ALLOWED_FOR_AI
	EVENT_START_COND DELTA=sim/cockpit2/electrical/APU_N1_percent > 0
	EVENT_END_COND DELTA=sim/cockpit2/electrical/APU_N1_percent < 0
END_SOUND_ATTACHMENT

# -------------------- APU door ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/apu/apu_door
	VEH_XYZ 0.000 1.436 19.177
	EVENT_START_COND ABS_DELTA=sim/cockpit2/electrical/APU_door > 0
	EVENT_END_COND ABS_DELTA=sim/cockpit2/electrical/APU_door <= 0
END_SOUND_ATTACHMENT

# -------------------- Pack 1 fan ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /b738/equipment/air/packs_fan
	VEH_XYZ -3.696 -0.069 -0.726
	PARAM_DREF_IDX 0
	EVENT_START_COND laminar/B738/sound/packs_flow[0] > 0.1
	EVENT_END_COND laminar/B738/sound/packs_flow[0] < 0.1
END_SOUND_ATTACHMENT

# -------------------- Pack 2 fan ---------------------
